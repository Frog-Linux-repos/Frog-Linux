---
componentName: frog

welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

strings:
    productName:         Frog Linux
    shortProductName:    Frog
    version:             Rolling
    shortVersion:        Rolling
    versionedName:       Frog Linux (Rolling)
    shortVersionedName:  Frog Rolling
    bootloaderEntryName: Frog
    productUrl:          https://github.com/Crazy10061/Frog-Linux
    supportUrl:          https://github.com/Crazy10061/Frog-Linux/issues
    releaseNotesUrl:     https://github.com/Crazy10061/Frog-Linux/releases

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
# show.qml binds its timer to presentation.activatedInCalamares, which is API 2.
# Without this the binding is undefined and the slideshow sticks on slide one.
slideshowAPI:            2

style:
    SidebarBackground:        "#AFD2AB"
    SidebarText:              "#243024"
    SidebarTextCurrent:       "#FFFFFF"
    SidebarBackgroundCurrent: "#6FA66B"
