#!/usr/bin/env bash
set -euo pipefail
trap 'rm -f /usr/local/bin/frog-configure-snapshots' EXIT

if ! awk '$2 == "/" && $3 == "btrfs" { found = 1 } END { exit !found }' /etc/fstab; then
    exit 0
fi

if ! snapper --no-dbus list-configs | awk '$1 == "root" { found = 1 } END { exit !found }'; then
    snapper --no-dbus -c root create-config /
fi

snapper --no-dbus -c root set-config \
    TIMELINE_CREATE=yes \
    TIMELINE_CLEANUP=yes \
    TIMELINE_LIMIT_HOURLY=10 \
    TIMELINE_LIMIT_DAILY=7 \
    TIMELINE_LIMIT_WEEKLY=4 \
    TIMELINE_LIMIT_MONTHLY=6 \
    TIMELINE_LIMIT_YEARLY=0 \
    NUMBER_CLEANUP=yes \
    NUMBER_LIMIT=10 \
    NUMBER_LIMIT_IMPORTANT=5

systemctl enable snapper-timeline.timer snapper-cleanup.timer

if [ -d /sys/firmware/efi/efivars ]; then
    if grep -q '^HOOKS=.*systemd' /etc/mkinitcpio.conf; then
        hook=sd-btrfs-overlayfs
    else
        hook=btrfs-overlayfs
    fi

    if ! grep -q "${hook}" /etc/mkinitcpio.conf; then
        sed -i "s/\(filesystems\)/\1 ${hook}/" /etc/mkinitcpio.conf
    fi
fi
